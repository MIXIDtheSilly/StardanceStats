# Copy to .env and adjust. All settings are optional; defaults shown.

STARDANCE_BASE_URL=https://stardance.hackclub.com

# Identify the crawler and give Hack Club a way to reach you. Please put a
# real contact address here before running a full crawl.
STARDANCE_USER_AGENT=stardance-stats/0.1 (+https://github.com/you/stardance-stats; contact: you@example.com)

# Upstream throttles at 600 req / 5 min and 120 / min per IP. Stay well under.
STARDANCE_REQUESTS_PER_SECOND=1.0
STARDANCE_MAX_CONCURRENCY=1

STARDANCE_MONGO_URL=mongodb://localhost:27017
STARDANCE_MONGO_DB=stardance_stats

# Force a snapshot at least this often even when nothing changed.
STARDANCE_SNAPSHOT_HEARTBEAT_HOURS=24
# Reject a snapshot whose monotonic counters drop by more than this fraction.
STARDANCE_ANOMALY_DROP_THRESHOLD=0.20
